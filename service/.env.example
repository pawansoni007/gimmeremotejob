# Copy to .env and adjust.

# --- LLM (local Ollama, OpenAI-compatible endpoint) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=minimax-m3:cloud
# Ollama's local endpoint ignores the key for local models; cloud (:cloud) auth is
# handled by your signed-in Ollama. A placeholder keeps OpenAI-compatible clients happy.
OLLAMA_API_KEY=ollama

# --- Database (matches docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://apply:apply@localhost:5432/apply

# --- Service ---
SERVICE_PORT=8756

# Output budget — minimax-m3 is a thinking model, so reasoning eats into this.
OLLAMA_MAX_TOKENS=8192
OLLAMA_TIMEOUT_SECONDS=300

# Your background (copy profile.example.md -> profile.md and edit). Grounds the
# drafted answers; without it the model uses [FILL: ...] placeholders.
APPLICANT_PROFILE_PATH=profile.md
